# 统一换行符：仓库内一律 LF，检出时不转换，避免 Windows 上反复出现假 diff。
* text=auto eol=lf

*.ts   text eol=lf
*.tsx  text eol=lf
*.mjs  text eol=lf
*.cjs  text eol=lf
*.json text eol=lf
*.css  text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

*.png  binary
*.ico  binary
*.icns binary
*.svg  text eol=lf
