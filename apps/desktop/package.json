{
  "name": "@moyu/desktop",
  "version": "0.3.6",
  "private": true,
  "description": "MoyuBot Windows desktop workspace (Electron + React)",
  "license": "MIT",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -p tsconfig.electron.json && vite build",
    "build:main": "tsc -p tsconfig.electron.json",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "dist": "tsc -p tsconfig.electron.json && vite build && electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "@moyu/core": "workspace:*",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.2.7",
    "mammoth": "^1.13.0",
    "marked": "^16.4.0",
    "motion": "^14.10.1",
    "node-pty": "^1.1.0",
    "qrcode": "1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^42.1.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  },
  "build": {
    "appId": "sh.moyubot.desktop",
    "productName": "MoyuBot",
    "artifactName": "MoyuBot.Setup.${version}.exe",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "../../licenses",
        "to": "licenses"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MoyuBot",
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "language": "2052"
    },
    "npmRebuild": false,
    "asarUnpack": [
      "**/node_modules/node-pty/**"
    ]
  }
}
